# Environment Variables Example
# Copy this to .env.local and fill in your values

# Site Configuration
NEXT_PUBLIC_SITE_NAME=Pottery Brand
NEXT_PUBLIC_SITE_URL=https://pottery-brand.com

# Admin Settings
# IMPORTANT: Change the default password in config/admin.ts

# Analytics (optional)
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# NEXT_PUBLIC_SENTRY_DSN=

# Email Service (optional)
# SENDGRID_API_KEY=
# MAILGUN_API_KEY=

# Payment Processing (optional)
# STRIPE_PUBLIC_KEY=
# STRIPE_SECRET_KEY=
# PAYPAL_CLIENT_ID=

# CDN (optional)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
